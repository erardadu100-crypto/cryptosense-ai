async def update_socialfrom fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
import httpx
import asyncio
from dotenv import load_dotenv
import os
from apscheduler.schedulers.asyncio import AsyncIOScheduler

load_dotenv()
ETHERSCAN_KEY = os.getenv("ETHERSCAN_API_KEY")
REDDIT_CLIENT_ID = os.getenv("REDDIT_CLIENT_ID", "")
REDDIT_CLIENT_SECRET = os.getenv("REDDIT_CLIENT_SECRET", "")

app = FastAPI(title="CryptoSense AI Backend")
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["*"], allow_headers=["*"])

# ===================== CACHE =====================
cache = {
    "pairs_eth": {"pairs": []},
    "pairs_meme": {"pairs": []},
    "global": {},
    "whales": {"whales": []},
    "new_tokens": [],
    "trending": [],
    "sentiment": {"score": 62, "label": "Greed", "crypto_fear": 62},
    "top_tokens": [],
    "social": {"posts": []},
}

scheduler = AsyncIOScheduler()

# ===================== FETCH HELPER =====================
async def fetch(url, headers=None):
    try:
        async with httpx.AsyncClient(timeout=10) as client:
            r = await client.get(url, headers=headers or {})
            return r.json()
    except Exception as e:
        print(f"Fetch error: {url[:60]} — {e}")
        return None

# ===================== ETHERSCAN =====================
async def update_whales():
    wallets = [
        "0x28C6c06298d514Db089934071355E5743bf21d60",
        "0x21a31Ee1afC51d94C2eFcCAa2092aD1028285549",
        "0xDFd5293D8e347dFe59E90eFd55b2956a1343963B",
    ]
    all_txs = []
    async with httpx.AsyncClient(timeout=15) as client:
        for wallet in wallets:
            try:
                url = f"https://api.etherscan.io/v2/api?chainid=1&module=account&action=tokentx&address={wallet}&startblock=0&endblock=99999999&sort=desc&apikey={ETHERSCAN_KEY}"
                r = await client.get(url)
                txs = r.json().get("result", [])[:15]
                for tx in txs:
                    try:
                        value = int(tx.get("value", 0))
                        decimals = int(tx.get("tokenDecimal", 18))
                        amount = value / (10 ** decimals)
                        if amount < 100:
                            continue
                        from_addr = tx.get("from", "")
                        to_addr = tx.get("to", "")
                        all_txs.append({
                            "symbol": tx.get("tokenSymbol", "???"),
                            "token_name": tx.get("tokenName", ""),
                            "amount": round(amount, 2),
                            "from": from_addr[:6] + "..." + from_addr[-4:],
                            "to": to_addr[:6] + "..." + to_addr[-4:],
                            "wallet": wallet[:6] + "..." + wallet[-4:],
                            "hash": tx.get("hash", ""),
                            "timestamp": int(tx.get("timeStamp", 0)),
                            "type": "buy" if to_addr.lower() == wallet.lower() else "sell",
                            "etherscan_url": f"https://etherscan.io/tx/{tx.get('hash','')}"
                        })
                    except:
                        continue
            except:
                continue
    all_txs.sort(key=lambda x: x["timestamp"], reverse=True)
    if all_txs:
        cache["whales"] = {"whales": all_txs[:25]}
        print(f"✓ Whales: {len(all_txs)}")

async def get_token_holders(contract_address: str):
    url = f"https://api.etherscan.io/v2/api?chainid=1&module=token&action=tokenholderlist&contractaddress={contract_address}&page=1&offset=10&apikey={ETHERSCAN_KEY}"
    d = await fetch(url)
    if not d or d.get("status") != "1":
        return []
    return d.get("result", [])

async def get_contract_info(contract_address: str):
    url = f"https://api.etherscan.io/v2/api?chainid=1&module=contract&action=getsourcecode&address={contract_address}&apikey={ETHERSCAN_KEY}"
    d = await fetch(url)
    if not d or d.get("status") != "1":
        return {}
    result = d.get("result", [{}])[0]
    return {
        "contract_name": result.get("ContractName", "Unknown"),
        "is_verified": bool(result.get("SourceCode")),
        "compiler_version": result.get("CompilerVersion", ""),
        "is_proxy": result.get("Proxy", "0") == "1",
    }

# ===================== DEXSCREENER =====================
async def update_pairs_eth():
    d = await fetch("https://api.dexscreener.com/latest/dex/search?q=ETH USDC")
    if d and d.get("pairs"):
        cache["pairs_eth"] = d
        print("✓ ETH pairs updated")

async def update_pairs_meme():
    d = await fetch("https://api.dexscreener.com/latest/dex/search?q=PEPE SHIB WIF BONK DOGE")
    if d and d.get("pairs"):
        cache["pairs_meme"] = d
        print("✓ Meme pairs updated")

async def update_new_tokens():
    d = await fetch("https://api.dexscreener.com/token-profiles/latest/v1")
    if d and isinstance(d, list):
        cache["new_tokens"] = d
        print("✓ New tokens updated")

async def update_trending():
    d = await fetch("https://api.dexscreener.com/token-boosts/top/v1")
    if d and isinstance(d, list):
        cache["trending"] = d[:20]
        print("✓ Trending updated")

async def get_token_pairs(address: str):
    d = await fetch(f"https://api.dexscreener.com/latest/dex/search?q={address}")
    return d or {"pairs": []}

# ===================== COINGECKO =====================
async def update_global():
    d = await fetch("https://api.coingecko.com/api/v3/global")
    if d:
        cache["global"] = d
        print("✓ Global updated")

async def update_top_tokens():
    d = await fetch("https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=20&page=1&sparkline=false&price_change_percentage=24h")
    if d and isinstance(d, list):
        cache["top_tokens"] = d
        print("✓ Top tokens updated")

async def get_token_history(coin_id: str, days: int = 7):
    d = await fetch(f"https://api.coingecko.com/api/v3/coins/{coin_id}/market_chart?vs_currency=usd&days={days}")
    return d or {}

# ===================== SENTIMENT =====================
async def update_sentiment():
    try:
        # Fear & Greed Index
        d = await fetch("https://api.alternative.me/fng/?limit=1")
        if d and d.get("data"):
            val = int(d["data"][0]["value"])
            label = d["data"][0]["value_classification"]
            cache["sentiment"]["score"] = val
            cache["sentiment"]["label"] = label
            cache["sentiment"]["crypto_fear"] = val
            print(f"✓ Sentiment: {val} ({label})")
    except Exception as e:
        print(f"Sentiment error: {e}")

async def update_social():
    """Reddit crypto sentiment"""
    try:
        headers = {"User-Agent": "CryptoSense/1.0"}
        posts = []

        subreddits = ["CryptoCurrency", "ethereum", "solana", "defi"]
        for sub in subreddits[:2]:
            d = await fetch(f"https://www.reddit.com/r/{sub}/hot.json?limit=5", headers=headers)
            if d and d.get("data", {}).get("children"):
                for post in d["data"]["children"][:3]:
                    p = post["data"]
                    posts.append({
                        "title": p.get("title", "")[:100],
                        "subreddit": p.get("subreddit", ""),
                        "score": p.get("score", 0),
                        "comments": p.get("num_comments", 0),
                        "url": f"https://reddit.com{p.get('permalink', '')}",
                        "sentiment": "bullish" if p.get("score", 0) > 1000 else "neutral",
                    })

        if posts:
            cache["social"] = {"posts": posts}
            print(f"✓ Social: {len(posts)} posts")
    except Exception as e:
        print(f"Social error: {e}")

# ===================== AI SCORING =====================
def calculate_ai_score(pair_data: dict, whale_activity: list = [], social_score: float = 50) -> dict:
    score = 50
    signals = []

    vol = float(pair_data.get("volume", {}).get("h24", 0) or 0)
    liq = float(pair_data.get("liquidity", {}).get("usd", 0) or 0)
    chg_1h = float(pair_data.get("priceChange", {}).get("h1", 0) or 0)
    chg_24h = float(pair_data.get("priceChange", {}).get("h24", 0) or 0)
    buys = int(pair_data.get("txns", {}).get("h24", {}).get("buys", 0) or 0)
    sells = int(pair_data.get("txns", {}).get("h24", {}).get("sells", 0) or 0)

    # Volume signals
    if vol > 1000000: score += 15; signals.append("🔥 High volume")
    elif vol > 100000: score += 8; signals.append("📈 Good volume")

    # Liquidity signals
    if liq > 500000: score += 15; signals.append("💧 Strong liquidity")
    elif liq > 50000: score += 8; signals.append("💧 Good liquidity")
    elif liq < 10000: score -= 20; signals.append("⚠️ Low liquidity")

    # Price momentum
    if chg_24h > 20: score += 10; signals.append("🚀 Strong uptrend")
    elif chg_24h > 5: score += 5; signals.append("📈 Positive momentum")
    elif chg_24h < -30: score -= 15; signals.append("🔴 Sharp decline")
    elif chg_24h < -10: score -= 8; signals.append("⬇️ Downtrend")

    # Buy/Sell ratio
    if buys > 0 and sells > 0:
        ratio = buys / (buys + sells)
        if ratio > 0.7: score += 10; signals.append("💚 Strong buy pressure")
        elif ratio > 0.55: score += 5; signals.append("📊 Buy dominant")
        elif ratio < 0.3: score -= 10; signals.append("🔴 Sell pressure")

    # Whale activity
    if whale_activity:
        whale_buys = sum(1 for w in whale_activity if w.get("type") == "buy")
        whale_sells = sum(1 for w in whale_activity if w.get("type") == "sell")
        if whale_buys > whale_sells: score += 10; signals.append("🐳 Whale accumulation")
        elif whale_sells > whale_buys: score -= 10; signals.append("🚨 Whale dumping")

    # Social sentiment
    if social_score > 70: score += 5; signals.append("📱 Positive social")
    elif social_score < 30: score -= 5; signals.append("📱 Negative social")

    score = max(5, min(95, score))

    # Risk level
    if score >= 70: risk = "LOW"
    elif score >= 45: risk = "MEDIUM"
    else: risk = "HIGH"

    return {
        "bullish_probability": score,
        "risk_level": risk,
        "whale_strength": "HIGH" if score > 65 else "MEDIUM" if score > 45 else "LOW",
        "sentiment_score": social_score,
        "signals": signals[:5],
    }

# ===================== STARTUP =====================
async def preload():
    print("⚡ Preloading all data...")
    await asyncio.gather(
        update_pairs_eth(),
        update_pairs_meme(),
        update_global(),
        update_whales(),
        update_new_tokens(),
        update_trending(),
        update_sentiment(),
        update_social(),
        update_top_tokens(),
    )
    print("✅ All data ready!")

@app.on_event("startup")
async def startup():
    await preload()
    scheduler.add_job(update_pairs_eth, 'interval', seconds=10)
    scheduler.add_job(update_pairs_meme, 'interval', seconds=15)
    scheduler.add_job(update_global, 'interval', seconds=60)
    scheduler.add_job(update_whales, 'interval', seconds=30)
    scheduler.add_job(update_new_tokens, 'interval', seconds=30)
    scheduler.add_job(update_trending, 'interval', seconds=20)
    scheduler.add_job(update_sentiment, 'interval', seconds=300)
    scheduler.add_job(update_social, 'interval', seconds=120)
    scheduler.add_job(update_top_tokens, 'interval', seconds=60)
    scheduler.start()
    print("🚀 All background jobs started!")

@app.on_event("shutdown")
async def shutdown():
    scheduler.shutdown()

# ===================== ENDPOINTS =====================
@app.get("/")
def root():
    return {"status": "CryptoSense AI ✅", "jobs": "running"}

@app.get("/api/global")
def get_global():
    return cache["global"]

@app.get("/api/pairs/{query}")
def get_pairs(query: str):
    q = query.upper()
    if any(x in q for x in ["PEPE","SHIB","WIF","BONK","DOGE","FLOKI","MEME"]):
        return cache["pairs_meme"]
    return cache["pairs_eth"]

@app.get("/api/whales")
def get_whales():
    return cache["whales"]

@app.get("/api/new-tokens")
def get_new_tokens():
    return cache["new_tokens"]

@app.get("/api/trending")
def get_trending():
    return {"trending": cache["trending"]}

@app.get("/api/sentiment")
def get_sentiment():
    return cache["sentiment"]

@app.get("/api/social")
def get_social():
    return cache["social"]

@app.get("/api/top-tokens")
def get_top_tokens():
    return {"tokens": cache["top_tokens"]}

@app.get("/api/token/{address}")
async def get_token_detail(address: str):
    pairs_data = await get_token_pairs(address)
    pair = pairs_data.get("pairs", [{}])[0] if pairs_data.get("pairs") else {}
    contract_info = await get_contract_info(address) if address.startswith("0x") else {}
    whales = cache["whales"].get("whales", [])
    social_score = cache["sentiment"].get("score", 50)
    ai_analysis = calculate_ai_score(pair, whales, social_score)

    return {
        "pair": pair,
        "contract": contract_info,
        "ai_analysis": ai_analysis,
        "whale_activity": whales[:5],
        "sentiment": cache["sentiment"],
    }

@app.get("/api/analyze/{address}")
async def analyze_contract(address: str):
    pairs_data = await get_token_pairs(address)
    pair = pairs_data.get("pairs", [{}])[0] if pairs_data.get("pairs") else {}
    contract_info = await get_contract_info(address) if address.startswith("0x") else {}
    whales = cache["whales"].get("whales", [])
    ai_analysis = calculate_ai_score(pair, whales)

    liq = float(pair.get("liquidity", {}).get("usd", 0) or 0)
    chg = float(pair.get("priceChange", {}).get("h24", 0) or 0)

    return {
        "token_name": pair.get("baseToken", {}).get("name", "Unknown"),
        "symbol": pair.get("baseToken", {}).get("symbol", "???"),
        "chain": pair.get("chainId", "unknown"),
        "price": pair.get("priceUsd", "0"),
        "liquidity": liq,
        "volume_24h": float(pair.get("volume", {}).get("h24", 0) or 0),
        "change_24h": chg,
        "contract": contract_info,
        "honeypot_risk": "HIGH" if liq < 5000 else "LOW",
        "rug_risk": "HIGH" if (chg < -40 or liq < 10000) else "LOW",
        "liquidity_locked": liq > 50000,
        "ai_analysis": ai_analysis,
    }
